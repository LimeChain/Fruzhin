Description: Peer discovery
Network: ./0002-peer-discovery.toml
Creds: config

# metrics
alice: log line matches "Successfully connected to ([1-9]\d*) boot nodes" within 30 seconds
alice: log line matches "Node successfully connected to a peer! Sync can start" within 30 seconds
alice: log line matches "Connected peers: ([1-9]\d*)" within 120 seconds
alice: log line matches "Sending handshake to [a-fA-F0-9]+" within 50 seconds
alice: log line matches "Sending grandpa handshake to [a-fA-F0-9]+" within 50 seconds
alice: log line matches "Received grandpa handshake from [a-fA-F0-9]+" within 50 seconds
alice: log line matches "Sending beefy handshake to [a-fA-F0-9]+" within 50 seconds
alice: log line matches "Received beefy handshake from [a-fA-F0-9]+" within 50 seconds
